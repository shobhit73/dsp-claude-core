# Per-implementer config & secrets — NEVER commit
config/paths.local.json
**/_secrets/
*-creds.json
*-jwt.json

# Python
__pycache__/
*.pyc
*.pyo

# Caches / local outputs
**/names_cache.json
# (the onboarding-logs OUTPUT dir lives OUTSIDE this repo via DSP_LOGS_OUT — nothing to ignore here;
#  do NOT add a bare `onboarding-logs/` rule, it would hide the .claude/skills/onboarding-logs skill)

# Client data belongs in the client's own folder, not in this repo
*.xlsx
*.xls
*.xlsm
*.csv
~$*
